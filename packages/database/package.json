{
  "name": "@harness-arena/database",
  "version": "0.1.0",
  "description": "Drizzle schema, migrations and connection helpers (Postgres in production, embedded PGlite for dev/tests).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('drizzle','dist/drizzle',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@harness-arena/protocol": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
