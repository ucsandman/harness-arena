# ---- Web app (apps/web) ----
# Postgres connection string. Leave empty to use an embedded PGlite database in ./.data (dev/demo only).
DATABASE_URL=
# Public URL of the web app (used for OAuth callbacks and device-login links).
ARENA_WEB_URL=http://localhost:3000
# GitHub OAuth app for "Sign in with GitHub". Callback URL: <ARENA_WEB_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional GitHub token used ONLY for read-only repository inspection on the server (raises rate limits).
GITHUB_INSPECT_TOKEN=
# Number of reverse proxies in front of the web app that append to x-forwarded-for. 0 (default) means the
# header is untrusted and ignored, and rate limits fall back to one shared window.
ARENA_TRUSTED_PROXY_HOPS=0
# Dev-only sign-in without GitHub OAuth (set to 1). Ignored when NODE_ENV=production.
ARENA_DEV_LOGIN=
# Directory for the embedded PGlite database when DATABASE_URL is empty. Use one ABSOLUTE path for the
# seed and the server (the seed runs inside packages/database, so a relative path lands elsewhere).
ARENA_DATA_DIR=
# Canonical public URL for robots.txt, the sitemap and page metadata. Set it to the same value as ARENA_WEB_URL.
ARENA_SITE_URL=
# Fallback for ARENA_SITE_URL, for hosts that only expose NEXT_PUBLIC_* to the build. Same value again.
NEXT_PUBLIC_SITE_URL=

# ---- CLI (packages/cli), core and the MCP server ----
# Where the CLI stores mirrors, workspaces and battle records. Default: ~/.harness-arena
ARENA_HOME=
# Web app the CLI connects to with `arena login`.
ARENA_SERVER_URL=http://localhost:3000
# Optional GitHub token for reading a GitHub issue as the battle task and for inspecting a GitHub harness
# over the REST API (raises the rate limit, reaches private repositories). GH_TOKEN is read as a fallback.
GITHUB_TOKEN=
